# Copy this file to .env and edit.

# How often to read CPU/RAM (seconds) and how often to save a point to SQLite
SAMPLE_INTERVAL=2
STORE_EVERY=10
RETENTION_DAYS=7
DB_PATH=./monitor.db

# Disks to show (comma separated mount points). Add the 1TB HDD mount later.
DISK_MOUNTS=/

# systemd services to watch. Check your exact PHP-FPM unit name with:
#   systemctl list-units --type=service | grep fpm
SERVICES=nginx,mariadb,cloudflared,php8.4-fpm

# Show PM2 apps (the backend must run as the same Linux user that owns PM2)
PM2=1

# Log files to tail, as name=path, comma separated
LOG_FILES=nginx-error=/var/log/nginx/error.log,nginx-access=/var/log/nginx/access.log
# Magento example:
# LOG_FILES=nginx-error=/var/log/nginx/error.log,magento-exception=/var/www/html/magento/var/log/exception.log,magento-system=/var/www/html/magento/var/log/system.log

# 1 = also stream warnings and errors from journalctl (all system services)
JOURNAL=1

# Only needed in development, when the frontend runs on another origin
CORS_ORIGINS=http://localhost:3006

# Telegram alerts (leave empty to turn alerts off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CPU_ALERT=90
MEM_ALERT=90
DISK_ALERT=90
ALERT_COOLDOWN=900
