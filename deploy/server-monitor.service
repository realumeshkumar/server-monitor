# /etc/systemd/system/server-monitor.service
# Replace "umesh" with your Linux username (the same user that runs PM2).
[Unit]
Description=Server Monitor backend (FastAPI)
After=network.target

[Service]
User=umesh
# adm = read /var/log/nginx, systemd-journal = read journalctl
SupplementaryGroups=adm systemd-journal
WorkingDirectory=/var/www/html/server-monitor/backend
EnvironmentFile=/var/www/html/server-monitor/backend/.env
# PATH must include the folder where `pm2` lives (check with: which pm2)
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/var/www/html/server-monitor/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
